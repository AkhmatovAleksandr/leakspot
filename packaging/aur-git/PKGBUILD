# Maintainer: Akhmatov Aleksandr Tarasovich (runvoid) <runvoid@users.noreply.github.com>
pkgname=leakspot-git
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="Zero-overhead process memory and resource leak watcher for Linux systems (VCS git version)"
arch=('x86_64')
url="https://github.com/runvoid/leakspot"
license=('MIT')
depends=('glibc')
makedepends=('git' 'cmake' 'ninja' 'clang' 'mold')
provides=('leakspot')
conflicts=('leakspot')
source=("git+https://github.com/runvoid/leakspot.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/leakspot"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "1.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -B build -S leakspot \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_CXX_COMPILER=clang++
    ninja -C build
}

check() {
    ninja -C build run_all_tests
}

package() {
    DESTDIR="${pkgdir}" ninja -C build install
    install -Dm644 leakspot/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 leakspot/README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
